{
  "name": "@drkxbt/audiogram",
  "version": "0.15.1",
  "description": "Turn a Spaces or podcast recording into a captioned video clip for X, TikTok, Reels, Shorts or LinkedIn, in the browser: pick the moment, time the captions, choose a look, and export an MP4. No upload, no watermark, no dependencies.",
  "license": "MIT",
  "author": "drk",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./audiogram.css": "./audiogram.css"
  },
  "files": [
    "dist",
    "audiogram.css"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test \"test/*.test.js\"",
    "demo": "tsc -p tsconfig.json && node demo/serve.js"
  },
  "devDependencies": {
    "typescript": ">=5.4"
  },
  "keywords": [
    "audiogram",
    "podcast",
    "twitter-spaces",
    "x-spaces",
    "tiktok",
    "reels",
    "youtube-shorts",
    "captions",
    "subtitles",
    "waveform",
    "mp4",
    "webcodecs",
    "video",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drkxbt/audiogram.git"
  },
  "homepage": "https://drk.vc/source/audiogram"
}
